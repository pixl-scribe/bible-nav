{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bible Nav",
  "version": "0.1.0",
  "identifier": "org.bible-nav",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Bible Nav",
        "width": 1280,
        "height": 768,
        "backgroundColor": "#1d232a"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/"]
  }
}
